---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
---

<div class={`ad-slot ad-native ${className}`} id={id}>
  <iframe
    src="/ad-native.html"
    sandbox="allow-scripts allow-same-origin allow-popups"
    style="width:100%;height:250px;border:none;display:block;"
    loading="lazy"
    title="Advertisement"
  ></iframe>
</div>
