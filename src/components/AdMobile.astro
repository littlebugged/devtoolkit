---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
---

<div class={`ad-slot ad-mobile ${className}`} id={id}>
  <iframe
    src="/ad-mobile.html"
    sandbox="allow-scripts allow-same-origin allow-popups"
    style="width:320px;height:50px;border:none;display:block;margin:0 auto;"
    loading="lazy"
    title="Advertisement"
  ></iframe>
</div>
