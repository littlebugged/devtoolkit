---
import BaseLayout from './BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import AdNative from '../components/AdNative.astro';
import AdMobile from '../components/AdMobile.astro';
import type { Tool } from '../data/tools';
import { tools } from '../data/tools';
import Icon from '../components/Icon.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const sameCategoryTools = tools
  .filter(t => t.category === tool.category && t.slug !== tool.slug);
const crossCategoryTools = tools
  .filter(t => t.category !== tool.category && t.slug !== tool.slug)
  .slice(0, 3 - sameCategoryTools.length);
const relatedTools = [...sameCategoryTools, ...crossCategoryTools].slice(0, 3);

const toolUrl = new URL(`/tools/${tool.slug}`, Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.metaDescription,
  url: toolUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  softwareVersion: '1.0',
  author: {
    '@type': 'Organization',
    name: 'CatToolKit',
    url: Astro.site,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '120',
  },
};

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: String(Astro.site),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: tool.name,
      item: toolUrl,
    },
  ],
};
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  keywords={tool.keywords}
>
  <!-- Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <div class="tool-page">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span>{tool.name}</span>
    </nav>

    <AdBanner id="ad-top" class="ad-desktop-only" />

    <div class="tool-header">
      <h1>{tool.name}</h1>
      <p>{tool.description}</p>
    </div>

    <div class="tool-workspace">
      <slot />
    </div>

    <AdNative id="ad-middle" class="ad-desktop-only" />
    <AdMobile id="ad-middle-mobile" class="ad-mobile-only" />

    <!-- SEO Content -->
    <details class="tool-info-accordion">
      <summary class="tool-info-toggle">Learn more</summary>
      <slot name="info" />
    </details>

    <AdBanner id="ad-bottom" class="ad-desktop-only" />
    <AdMobile id="ad-bottom-mobile" class="ad-mobile-only" />

    {relatedTools.length > 0 && (
      <div class="related-tools">
        <h2>Related Tools</h2>
        <div class="tools-grid">
          {relatedTools.map(rt => (
            <a href={`/tools/${rt.slug}`} class="tool-card">
              <div class="tool-card-icon"><Icon name={rt.icon} /></div>
              <h3>{rt.name}</h3>
              <p>{rt.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
