---
import '../styles/global.css';
import CatPet from '../components/CatPet.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
}

const { title, description, keywords = [], canonical, ogImage } = Astro.props;
const siteName = 'CatToolKit';
const fullTitle = title === 'Home' ? `${siteName} — Local Developer Tools` : `${title} — ${siteName}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    (function() {
      try {
        var saved = localStorage.getItem('cattoolkit-theme');
        var mode = 'light';
        if (saved) {
          var t = JSON.parse(saved);
          if (t.auto) {
            var h = new Date().getHours();
            mode = (h >= 6 && h < 18) ? 'light' : 'dark';
          } else {
            mode = t.mode || 'light';
          }
        } else {
          var h = new Date().getHours();
          mode = (h >= 6 && h < 18) ? 'light' : 'dark';
          localStorage.setItem('cattoolkit-theme', JSON.stringify({ mode: mode, auto: true }));
        }
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(mode);
      } catch (_) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage || new URL('/og-default.png', Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage || new URL('/og-default.png', Astro.site).href} />

  <title>{fullTitle}</title>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3425124767136776" crossorigin="anonymous"></script>

  <!-- Google Fonts - Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="4.5"/>
            <ellipse cx="6" cy="8" rx="3" ry="2.5" transform="rotate(-30 6 8)"/>
            <ellipse cx="18" cy="8" rx="3" ry="2.5" transform="rotate(30 18 8)"/>
            <ellipse cx="5" cy="15" rx="2.6" ry="2" transform="rotate(-20 5 15)"/>
            <ellipse cx="19" cy="15" rx="2.6" ry="2" transform="rotate(20 19 15)"/>
            <ellipse cx="12" cy="19" rx="2.4" ry="1.8"/>
          </svg>
        </span>
        {siteName}
      </a>
      <nav>
        <ul class="nav-links">
          <li><a href="/">Tools</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <div class="theme-switcher">
        <button type="button" class="theme-mode-btn" aria-label="Toggle dark mode">
          <svg class="theme-mode-icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="theme-mode-icon-light" style="display:none;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; {new Date().getFullYear()} {siteName}. All tool processing runs locally in your browser.</p>
      <ul class="footer-links">
        <li><a href="/">All Tools</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>
  </footer>

  <!-- Cookie Consent Banner -->
  <div id="cookie-consent" class="cookie-consent" style="display:none">
    <div class="cookie-inner">
      <p>We use cookies for ads (Google AdSense). Your tool data stays local and is never collected. <a href="/privacy">Privacy Policy</a></p>
      <div class="cookie-btns">
        <button type="button" class="btn btn-primary cookie-accept">Accept</button>
        <button type="button" class="btn cookie-decline">Decline</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      var KEY = 'cattoolkit-cookie-consent';
      var banner = document.getElementById('cookie-consent');
      var consent = localStorage.getItem(KEY);

      if (!consent) {
        banner.style.display = '';
      }

      banner.querySelector('.cookie-accept').addEventListener('click', function() {
        localStorage.setItem(KEY, 'accepted');
        banner.style.display = 'none';
      });
      banner.querySelector('.cookie-decline').addEventListener('click', function() {
        localStorage.setItem(KEY, 'declined');
        banner.style.display = 'none';
      });
    })();
  </script>

  <!-- Copy Toast notification -->
  <div id="copy-toast" class="copy-toast">Copied!</div>

  <script is:inline>
    function showToast(msg) {
      const t = document.getElementById('copy-toast');
      t.textContent = msg || 'Copied!';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 1500);
    }
    function copyText(text) {
      navigator.clipboard.writeText(text).then(() => showToast());
    }
  </script>

  <script is:inline>
    (function() {
      const STORAGE_KEY = 'cattoolkit-theme';
      const root = document.documentElement;

      function saveTheme(mode, auto) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode: mode, auto: !!auto }));
      }

      function updateModeIcons() {
        const isLight = root.classList.contains('light');
        document.querySelectorAll('.theme-mode-icon-dark').forEach(el => el.style.display = isLight ? 'none' : 'block');
        document.querySelectorAll('.theme-mode-icon-light').forEach(el => el.style.display = isLight ? 'block' : 'none');
      }

      document.querySelectorAll('.theme-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const isLight = root.classList.toggle('light');
          root.classList.toggle('dark', !isLight);
          saveTheme(isLight ? 'light' : 'dark', false);
          updateModeIcons();
        });
      });

      updateModeIcons();
    })();
  </script>

  <CatPet />

</body>
</html>
