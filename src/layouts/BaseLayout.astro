---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
}

const { title, description, keywords = [], canonical, ogImage } = Astro.props;
const siteName = 'DevToolKit';
const fullTitle = title === 'Home' ? `${siteName} - Free Online Developer Tools` : `${title} - ${siteName}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('devtoolkit-theme');
        if (saved) {
          const t = JSON.parse(saved);
          if (t.mode === 'light') {
            document.documentElement.classList.add('light');
            document.documentElement.classList.remove('dark');
          }
          if (t.color) document.documentElement.setAttribute('data-theme', t.color);
        }
      } catch (_) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage || new URL('/og-default.png', Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage || new URL('/og-default.png', Astro.site).href} />

  <title>{fullTitle}</title>

  <!-- Performance hints -->
  <link rel="dns-prefetch" href="//www.googletagmanager.com" />
  <link rel="dns-prefetch" href="//www.highperformanceformat.com" />
  <link rel="dns-prefetch" href="//pl30613587.effectivecpmnetwork.com" />

  <!-- Language / Region -->
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <!-- Google Fonts - Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-icon">⚡</span>
        {siteName}
      </a>
      <nav>
        <ul class="nav-links">
          <li><a href="/">Tools</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <div class="theme-switcher">
        <button type="button" class="theme-mode-btn" aria-label="Toggle dark mode">
          <svg class="theme-mode-icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646z"/><path d="M18 2.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z" fill="currentColor" stroke="none" opacity="0.6"/></svg>
          <svg class="theme-mode-icon-light" style="display:none;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M4.22 4.22l1.77 1.77M18.01 18.01l1.77 1.77M2 12h2.5M19.5 12H22M4.22 19.78l1.77-1.77M18.01 5.99l1.77-1.77"/></svg>
        </button>
        <button type="button" class="theme-color-toggle" aria-label="Choose theme color">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5c-1.4 2.8-5.5 6.8-5.5 10a5.5 5.5 0 0 0 11 0c0-3.2-4.1-7.2-5.5-10z"/><path d="M9.5 16a2.5 2.5 0 0 0 2.5 2.5" stroke-opacity="0.4"/></svg>
        </button>
        <div class="theme-popover" role="dialog" aria-label="Theme colors">
          <span class="theme-popover-label">Theme color</span>
          <div class="theme-color-grid">
            <button type="button" class="theme-color-dot" data-color="indigo" aria-label="Indigo"></button>
            <button type="button" class="theme-color-dot" data-color="violet" aria-label="Violet"></button>
            <button type="button" class="theme-color-dot" data-color="cyan" aria-label="Cyan"></button>
            <button type="button" class="theme-color-dot" data-color="rose" aria-label="Rose"></button>
            <button type="button" class="theme-color-dot" data-color="emerald" aria-label="Emerald"></button>
            <button type="button" class="theme-color-dot" data-color="amber" aria-label="Amber"></button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; {new Date().getFullYear()} {siteName}. All tools run in your browser — no data is sent to any server.</p>
      <ul class="footer-links">
        <li><a href="/">All Tools</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </div>
  </footer>

  <!-- Copy Toast notification -->
  <div id="copy-toast" class="copy-toast">Copied!</div>

  <script is:inline>
    function showToast(msg) {
      const t = document.getElementById('copy-toast');
      t.textContent = msg || 'Copied!';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 1500);
    }
    function copyText(text) {
      navigator.clipboard.writeText(text).then(() => showToast());
    }
  </script>

  <script is:inline>
    (function() {
      const STORAGE_KEY = 'devtoolkit-theme';
      const root = document.documentElement;

      function saveTheme(mode, color) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode, color }));
      }

      function updateModeIcons() {
        const isLight = root.classList.contains('light');
        document.querySelectorAll('.theme-mode-icon-dark').forEach(el => el.style.display = isLight ? 'none' : 'block');
        document.querySelectorAll('.theme-mode-icon-light').forEach(el => el.style.display = isLight ? 'block' : 'none');
      }

      function updateColorDots() {
        const current = root.getAttribute('data-theme') || 'indigo';
        document.querySelectorAll('.theme-color-dot').forEach(dot => {
          dot.classList.toggle('active', dot.dataset.color === current);
        });
      }

      document.querySelectorAll('.theme-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const isLight = root.classList.toggle('light');
          root.classList.toggle('dark', !isLight);
          const color = root.getAttribute('data-theme') || 'indigo';
          saveTheme(isLight ? 'light' : 'dark', color);
          updateModeIcons();
        });
      });

      document.querySelectorAll('.theme-color-toggle').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const popover = btn.closest('.theme-switcher').querySelector('.theme-popover');
          popover.classList.toggle('open');
        });
      });

      document.querySelectorAll('.theme-color-dot').forEach(dot => {
        dot.addEventListener('click', () => {
          const color = dot.dataset.color;
          root.setAttribute('data-theme', color);
          const mode = root.classList.contains('light') ? 'light' : 'dark';
          saveTheme(mode, color);
          updateColorDots();
        });
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.theme-switcher')) {
          document.querySelectorAll('.theme-popover').forEach(p => p.classList.remove('open'));
        }
      });

      updateModeIcons();
      updateColorDots();
    })();
  </script>

  <!-- Auto-hide empty ad containers -->
  <script is:inline>
    setTimeout(function() {
      document.querySelectorAll('.ad-container').forEach(function(el) {
        var hasAd = el.querySelector('iframe, ins, img, [id^="container-"] > *');
        if (!hasAd || el.offsetHeight < 10) {
          el.style.display = 'none';
        }
      });
    }, 3000);
  </script>

  <!-- Adsterra global ad (popunder/social bar) - loaded async at end of body -->
  <script is:inline async data-cfasync="false" type='text/javascript' src="https://pl30613587.effectivecpmnetwork.com/b2/19/e0/b219e04b0e76ad939e61f83b271f5d1a.js"></script>
</body>
</html>
