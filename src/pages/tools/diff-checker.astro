---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlug } from '../../data/tools';
const tool = getToolBySlug('diff-checker')!;
---

<ToolLayout tool={tool}>
  <div class="tool-controls">
    <button id="btn-compare" class="btn btn-primary">Compare</button>
    <button id="btn-swap" class="btn">Swap</button>
    <button id="btn-clear" class="btn">Clear</button>
  </div>

  <div class="tool-panels">
    <div class="tool-panel">
      <label for="diff-left">Original Text</label>
      <textarea id="diff-left" placeholder="Paste original text here…">The quick brown fox
jumps over the lazy dog.
Hello world!
This line stays the same.</textarea>
    </div>
    <div class="tool-panel">
      <label for="diff-right">Modified Text</label>
      <textarea id="diff-right" placeholder="Paste modified text here…">The quick red fox
jumps over the lazy cat.
Hello universe!
This line stays the same.
A brand new line was added.</textarea>
    </div>
  </div>

  <div id="diff-output" class="diff-output"></div>

  <div slot="info">
    <h2>How to Use</h2>
    <p>Paste the original text on the left and the modified text on the right, then click <strong>Compare</strong>. Differences are highlighted: <span style="color:#4ade80;">green</span> for additions and <span style="color:#f87171;">red</span> for deletions. Identical lines are not highlighted.</p>
    <h3>What is Text Diff?</h3>
    <p>A text diff tool compares two pieces of text line by line and highlights the differences. It is essential for code reviews, document revisions, and configuration file comparisons. This tool runs entirely in your browser — no data is uploaded.</p>
  </div>

  <script is:inline>
    function computeDiff(a, b) {
      const aLines = a.split('\n');
      const bLines = b.split('\n');
      const maxLen = Math.max(aLines.length, bLines.length);
      const result = [];
      for (let i = 0; i < maxLen; i++) {
        const left = i < aLines.length ? aLines[i] : null;
        const right = i < bLines.length ? bLines[i] : null;
        if (left === right) {
          result.push({ type: 'equal', line: i + 1, text: left });
        } else if (left === null) {
          result.push({ type: 'add', line: i + 1, text: right });
        } else if (right === null) {
          result.push({ type: 'remove', line: i + 1, text: left });
        } else {
          result.push({ type: 'remove', line: i + 1, text: left });
          result.push({ type: 'add', line: i + 1, text: right });
        }
      }
      return result;
    }

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function runDiff() {
      const left = document.getElementById('diff-left').value;
      const right = document.getElementById('diff-right').value;
      const output = document.getElementById('diff-output');
      const diff = computeDiff(left, right);
      let adds = 0, removes = 0;
      const lines = diff.map(d => {
        const prefix = d.type === 'add' ? '+' : d.type === 'remove' ? '-' : ' ';
        const cls = d.type === 'add' ? 'diff-add' : d.type === 'remove' ? 'diff-remove' : 'diff-equal';
        if (d.type === 'add') adds++;
        if (d.type === 'remove') removes++;
        return `<div class="diff-line ${cls}"><span class="diff-prefix">${prefix}</span><span class="diff-text">${escapeHtml(d.text)}</span></div>`;
      }).join('');
      const summary = `<div class="diff-summary"><span class="diff-stat-add">+${adds} added</span> <span class="diff-stat-remove">-${removes} removed</span></div>`;
      output.innerHTML = summary + '<div class="diff-body">' + lines + '</div>';
    }

    document.getElementById('btn-compare').addEventListener('click', runDiff);
    document.getElementById('btn-swap').addEventListener('click', () => {
      const l = document.getElementById('diff-left');
      const r = document.getElementById('diff-right');
      [l.value, r.value] = [r.value, l.value];
    });
    document.getElementById('btn-clear').addEventListener('click', () => {
      document.getElementById('diff-left').value = '';
      document.getElementById('diff-right').value = '';
      document.getElementById('diff-output').innerHTML = '';
    });

    runDiff();
  </script>

  <style>
    .diff-output { margin-top: 16px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .diff-summary { padding: 10px 16px; background: var(--bg-card); border-bottom: 1px solid var(--border); font-size: 0.85rem; }
    .diff-stat-add { color: #4ade80; margin-right: 12px; }
    .diff-stat-remove { color: #f87171; }
    .diff-body { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.85rem; max-height: 500px; overflow-y: auto; }
    .diff-line { display: flex; padding: 2px 12px; line-height: 1.6; }
    .diff-prefix { width: 20px; flex-shrink: 0; color: var(--text-muted); user-select: none; }
    .diff-text { white-space: pre-wrap; word-break: break-all; }
    .diff-add { background: rgba(74, 222, 128, 0.1); }
    .diff-remove { background: rgba(248, 113, 113, 0.1); }
    .diff-add .diff-prefix { color: #4ade80; }
    .diff-remove .diff-prefix { color: #f87171; }
  </style>
</ToolLayout>
