---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import AdNative from '../components/AdNative.astro';
import AdMobile from '../components/AdMobile.astro';
import { categories, tools, getToolsByCategory } from '../data/tools';
---

<BaseLayout
  title="Home"
  description="Free online developer tools — JSON formatter, Base64 encoder, UUID generator, hash generator, and more. All tools run locally in your browser. No signup, no data collection."
  keywords={['online tools', 'developer tools', 'web tools', 'free tools', 'json formatter', 'base64', 'uuid generator']}
>
  <div class="hero">
    <h1>Free Online Developer Tools</h1>
    <p>Fast, private, and free. All tools run entirely in your browser — no data is ever sent to a server.</p>
  </div>

  <!-- Top Ad -->
  <AdBanner id="ad-home-top" class="ad-top" />

  {categories.map(cat => {
    const catTools = getToolsByCategory(cat.id);
    if (catTools.length === 0) return null;
    return (
      <section class="category-section">
        <h2 class="category-title">
          <span>{cat.icon}</span>
          {cat.name}
        </h2>
        <div class="tools-grid">
          {catTools.map(tool => (
            <a href={`/tools/${tool.slug}`} class="tool-card">
              <div class="tool-card-icon">{tool.icon}</div>
              <h3>{tool.name}</h3>
              <p>{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <!-- Bottom Ad -->
  <AdNative id="ad-home-bottom" class="ad-bottom ad-desktop-only" />
  <AdMobile id="ad-home-bottom-mobile" class="ad-bottom ad-mobile-only" />

  <!-- WebSite Schema for Google Sitelinks Search Box -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DevToolKit',
    url: 'https://xxmind.cc.cd',
    description: 'Free online developer tools — JSON formatter, Base64 encoder, UUID generator, hash generator, and more. All tools run locally in your browser.',
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'DevToolKit',
      url: 'https://xxmind.cc.cd',
      logo: {
        '@type': 'ImageObject',
        url: 'https://xxmind.cc.cd/favicon.svg',
      },
    },
  })} />

  <!-- ItemList Schema for tool collection -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Free Online Developer Tools',
    description: 'A collection of free, privacy-focused developer tools that run entirely in your browser.',
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.name,
      url: `https://xxmind.cc.cd/tools/${tool.slug}`,
    })),
  })} />

  <!-- FAQ Schema: helps machines understand content -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is DevToolKit?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'DevToolKit is a collection of free, fast, and privacy-focused online tools for developers, designers, and everyday users. Every tool runs 100% in your browser — your data never leaves your device.'
        }
      },
      {
        '@type': 'Question',
        name: 'Is DevToolKit free to use?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, all tools on DevToolKit are completely free to use. No signup, no account, and no hidden costs. Just open a tool and start using it instantly.'
        }
      },
      {
        '@type': 'Question',
        name: 'Is my data safe when using DevToolKit?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Absolutely. All tools run 100% client-side in your browser using JavaScript. Your data is never uploaded to any server, never stored, and never shared with anyone.'
        }
      },
      {
        '@type': 'Question',
        name: 'What tools are available on DevToolKit?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'DevToolKit offers JSON Formatter & Validator, Base64 Encoder/Decoder, URL Encoder/Decoder, UUID Generator, Hash Generator (SHA-1, SHA-256, SHA-512), Password Generator, Color Picker & Converter, Unix Timestamp Converter, Lorem Ipsum Generator, Word & Character Counter, Text Case Converter, and Markdown Preview.'
        }
      },
      {
        '@type': 'Question',
        name: 'Does DevToolKit work on mobile devices?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, DevToolKit is fully responsive and works perfectly on phones, tablets, and desktops. All tools are optimized for touch interfaces and smaller screens.'
        }
      }
    ]
  })} />
</BaseLayout>
